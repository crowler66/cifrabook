<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- PDF com grupos de até 12 páginas por imagem -->
    <ScrollView
        android:id="@+id/scrollViewPdf"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Container utilizado pelo PdfViewerActivity.kt -->
        <LinearLayout
            android:id="@+id/pdfPagesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="0dp"
            android:clipToPadding="false" />

    </ScrollView>

    <!-- Linha de progresso inferior -->
    <FrameLayout
        android:id="@+id/pdfProgressTrack"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:background="#33FFFFFF"
        android:elevation="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/pdfProgressFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="#FFFF3B30" />

    </FrameLayout>

    <!-- Menu flutuante de rolagem automática -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/floatingScrollMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="120dp"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Botão flutuante CB 3D -->
        <ImageView
            android:id="@+id/btnDotPoint"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/cb_3d"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Abrir controles de rolagem"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Painel transparente dos controles -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/expandedClockLayout"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:background="@android:color/transparent"
            android:elevation="4dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Diminuir velocidade -->
            <Button
                android:id="@+id/btnSpeedMinus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="−"
                android:textSize="20sp"
                android:contentDescription="Diminuir velocidade"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Relógio e botão Play/Pause original -->
            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.example.cifrabook.SpeedRingView
                    android:id="@+id/liquidRingView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <Button
                    android:id="@+id/btnPlayPauseCenter"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="▶"
                    android:textSize="18sp"
                    android:contentDescription="Iniciar ou pausar rolagem" />

            </FrameLayout>

            <!-- Aumentar velocidade -->
            <Button
                android:id="@+id/btnSpeedPlus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="+"
                android:textSize="20sp"
                android:contentDescription="Aumentar velocidade"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
